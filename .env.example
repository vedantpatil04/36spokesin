# 36 Spokes environment variables
#
# Copy to .env.local (git-ignored) and fill in what you need. Nothing is
# required: every integration stays off until its values are set.
#
# Only VITE_* variables reach the browser. Read them through src/lib/env.ts.

# Absolute site origin, no trailing slash. Enables canonical URLs, og:url and
# absolute social images. Set this on Vercel for production.
VITE_SITE_URL=http://localhost:8080/

# 36 Spokes API base URL, including the version path, no trailing slash.
# Local: run the API from backend/ (see backend/README.md).
VITE_API_URL=http://localhost:3000/api/v1

# Phase 4: Mapbox public token. Restrict it to your domains in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Razorpay key id (public). Payments arrive in a later phase.
VITE_RAZORPAY_KEY_ID=

# Server-only secrets never use the VITE_ prefix and never appear in this file.
# They belong to the API: see backend/.env.example.
