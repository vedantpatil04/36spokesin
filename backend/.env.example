# 36 Spokes API — environment variables
#
# Copy to .env (git-ignored) for local development. Real environments set these
# in the host's secret manager. Never commit real values.
# The API validates everything at startup and refuses to boot on bad config.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin of this API (no path). Used in API docs.
API_URL=http://localhost:3000
# Public origin of the web app. Also the default CORS origin.
# Render production: WEB_URL=https://36spokesin.vercel.app
WEB_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API. Defaults to WEB_URL.
# Never "*" in production.
# Render production: CORS_ORIGINS=https://36spokesin.vercel.app
CORS_ORIGINS=http://localhost:8080
# Express "trust proxy": set to 1 behind one proxy / load balancer so client IPs
# (rate limiting, session metadata) are read correctly. Leave unset locally.
# Render production: TRUST_PROXY=1  (Render places one LB in front of the service)
TRUST_PROXY=

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://spokes:spokes@localhost:5432/spokes_dev
# Render production: paste the "Internal Database URL" from the Render PostgreSQL dashboard.
# Used only by `npm run test:e2e`. The database name must contain "test"; tables are truncated.
TEST_DATABASE_URL=postgresql://spokes:spokes@localhost:5432/spokes_test

# ─── Authentication ─────────────────────────────────────────────────────────
# Two different random values, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=H6GDI0cmr_ltdq66GyNa8mncU34_rD-R1WH9iIXUYot6UFTndPFl-rJTkKB2mUFl
# Keys the HMAC digests of refresh tokens stored in the database.
JWT_REFRESH_SECRET=5scNKJaQskVUilzQXmHB2Ybe2BDATCA1g5RzFSGfpMCtyjb6UkMXM9e24p3BhEis
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie settings. Secure defaults to true in production.
# Use SAMESITE=none (with Secure) only if the web app and API are on different sites.
# Render+Vercel (*.onrender.com + *.vercel.app): AUTH_COOKIE_SAMESITE=none, AUTH_COOKIE_SECURE=true
# Shared custom domain (e.g. api.36spokes.in + 36spokes.in): AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=
# e.g. .36spokes.in to share the cookie between 36spokes.in and api.36spokes.in. Usually unset.
AUTH_COOKIE_DOMAIN=

# ─── Media storage (Cloudinary for local dev / R2 for production) ───────────
# Provider switch: "cloudinary" for local development/testing, "r2" for production.
# Leave empty to run without media storage (media endpoints return 503).
MEDIA_PROVIDER=

# Cloudinary (local development / testing provider)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (production provider)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public origin that serves the bucket through Cloudflare, e.g. https://media.36spokes.in
R2_PUBLIC_BASE_URL=
# Optional endpoint override for S3-compatible emulators. Normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT=

MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_UPLOAD_URL_TTL_SECONDS=600

# ─── Journey planner: travel data (free OpenStreetMap-based services) ───────
# Facts (places, routes, weather) come from these services, never from the AI.
# Defaults are the public instances; respect their usage policies or point these
# at your own. Results are cached in memory.
PLAN_GEOCODER_URL=https://nominatim.openstreetmap.org
PLAN_ROUTER_URL=https://router.project-osrm.org
PLAN_WEATHER_URL=https://api.open-meteo.com
PLAN_PLACES_URL=https://overpass-api.de/api/interpreter
# Asked only when the one above doesn't answer (it is often busy). Optional.
PLAN_PLACES_FALLBACK_URL=https://lz4.overpass-api.de/api/interpreter
# Identifies this app to those services (their policies ask for a contact).
# e.g. 36Spokes-JourneyPlanner/1.0 (https://36spokes.in; you@36spokes.in)
PLAN_USER_AGENT=
# ISO country codes the place search is limited to. Empty: worldwide.
PLAN_GEOCODER_COUNTRY_CODES=in
# INR per litre used for the fuel cost when the rider doesn't enter a price.
# Leave empty to show "not enough information" instead of guessing.
PLAN_FUEL_PRICE_PER_LITRE=
# Journey plans one client may request per minute.
PLAN_RATE_LIMIT_MAX=6

# ─── Journey planner: AI (writes the itinerary from the facts above) ────────
# The primary is tried first; the fallback only when it fails. Use "none" for
# no fallback. Keys stay on the server.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=ollama
AI_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
# Leave empty to use a current Flash model reported by the Gemini API.
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty to use the first model installed in Ollama.
OLLAMA_MODEL=

# ─── Rate limiting (per client IP, per route) ───────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Stricter limit for register, login and refresh.
RATE_LIMIT_AUTH_MAX=10

# ─── Logging and docs ───────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent. Default: debug locally, info in production.
LOG_LEVEL=debug
# Swagger UI at /api/docs. Default: on outside production.
SWAGGER_ENABLED=true
