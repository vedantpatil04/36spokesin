model PathCard {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String        @unique
  title          String
  tagline        String?
  description    String?
  ctaLabel       String        @map("cta_label")
  destinationUrl String        @map("destination_url")
  badge          String?
  imageUrl       String?       @map("image_url")
  imageMediaId   String?       @map("image_media_id") @db.Uuid
  sortOrder      Int           @default(0) @map("sort_order")
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  image MediaAsset? @relation("PathCardImage", fields: [imageMediaId], references: [id], onDelete: Restrict)

  @@index([status, sortOrder])
  @@index([imageMediaId])
  @@map("path_cards")
}
